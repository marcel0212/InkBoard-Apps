{
  "id": "formel-1",
  "name": {
    "de": "Formel 1",
    "en": "Formula 1"
  },
  "shortName": {
    "de": "F1",
    "en": "F1"
  },
  "version": "1.1.3",
  "apiLevel": 11,
  "pages": [
    {
      "de": "Nächstes Rennen",
      "en": "Next race"
    },
    {
      "de": "WM-Wertung",
      "en": "Standings"
    },
    {
      "de": "Letzte Session",
      "en": "Last session"
    }
  ],
  "refreshMinutes": 30,
  "retrySeconds": 60,
  "widget": {
    "w": 280,
    "h": 110
  },
  "permissions": {
    "net": [
      "api.jolpi.ca",
      "api.openf1.org"
    ]
  },
  "settings": [
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "cards",
        "flat",
        "compact"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "cards": "Tile (Kacheln)",
          "flat": "Ledger (Zeilen)",
          "compact": "Nibble (Tabelle)",
          "relief": "Bump (Tiefe)",
          "klar": "Gamut (Apple)"
        },
        "en": {
          "cards": "Tile (tiles)",
          "flat": "Ledger (rows)",
          "compact": "Nibble (table)",
          "relief": "Bump (depth)",
          "klar": "Gamut (Apple)"
        }
      },
      "label": {
        "de": "Darstellung",
        "en": "Layout"
      },
      "help": {
        "de": "Tile zeigt Kacheln, Ledger Zeilen, Nibble eine kompakte Tabelle. Die Streckenlayouts und der Zeitplan gibt es in allen drei Darstellungen.",
        "en": "Tile shows tiles, Ledger rows, Nibble a compact table. Track layouts and the schedule are available in all three layouts."
      }
    },
    {
      "key": "details",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Zusatzinfos zeigen (Streckendaten, Rundenrekord)",
        "en": "Show extra info (track data, lap record)"
      },
      "help": {
        "de": "Aus: unter der Strecke stehen keine Länge, Runden, Kurven und kein Rundenrekord. Die Vorschau in Studio, Mac- und iOS-App zeigt weiterhin alles.",
        "en": "Off: no length, laps, corners or lap record below the track. The preview in Studio, Mac and iOS app still shows everything."
      }
    },
    {
      "key": "wTrack",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Streckenlayout statt Zielflagge",
        "en": "Track layout instead of checkered flag"
      },
      "group": "widget"
    },
    {
      "key": "wLast",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "Letztes Rennen zusätzlich",
        "en": "Add last race"
      },
      "group": "widget"
    },
    {
      "key": "wLocality",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Ort anzeigen",
        "en": "Show location"
      },
      "group": "widget"
    },
    {
      "key": "wCompact",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "Kompakt",
        "en": "Compact"
      },
      "group": "widget"
    }
  ]
}
