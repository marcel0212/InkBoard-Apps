{
  "id": "spotify",
  "name": {
    "de": "Spotify",
    "en": "Spotify"
  },
  "version": "1.0.9",
  "apiLevel": 21,
  "pages": 1,
  "refreshMinutes": 1,
  "widget": {
    "autoCompact": true,
    "w": 340,
    "h": 100
  },
  "permissions": {
    "spotify": true
  },
  "sections": [
    {
      "id": "account",
      "title": {
        "de": "Spotify-Konto",
        "en": "Spotify account"
      }
    },
    {
      "id": "look",
      "title": {
        "de": "Darstellung",
        "en": "Appearance"
      }
    }
  ],
  "settings": [
    {
      "key": "account",
      "type": "connect",
      "device": "spotify",
      "label": {
        "de": "Verbindung",
        "en": "Connection"
      },
      "section": "account"
    },
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "cards",
        "flat",
        "compact"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "cards": "Tile (Kacheln)",
          "flat": "Ledger (zweispaltig)",
          "compact": "Nibble (Datenblatt)",
          "relief": "Bump (Tiefe)",
          "klar": "Gamut (Apple)"
        },
        "en": {
          "cards": "Tile (tiles)",
          "flat": "Ledger (two columns)",
          "compact": "Nibble (data sheet)",
          "relief": "Bump (depth)",
          "klar": "Gamut (Apple)"
        }
      },
      "label": {
        "de": "Stil der App-Seite",
        "en": "App page style"
      },
      "help": {
        "de": "Tile: großes Cover mit Steuer-Kacheln links, Titel, Status und Fortschritt in Karten rechts. Ledger: schlichte zweispaltige Ansicht mit Cover, Titel und Fortschrittslinie. Nibble: kompaktes Datenblatt mit sieben Zeilen und kleinem Cover.",
        "en": "Tile: large cover with control tiles on the left, title, status and progress in cards on the right. Ledger: plain two-column view with cover, title and a progress line. Nibble: compact data sheet with seven rows and a small cover."
      },
      "section": "look"
    },
    {
      "key": "details",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Zusatzinfos zeigen (Albumname)",
        "en": "Show extra info (album name)"
      },
      "help": {
        "de": "Aus: der Albumname wird nicht angezeigt. Die Vorschau in Studio, Mac- und iOS-App zeigt weiterhin alles.",
        "en": "Off: the album name is not shown. The preview in Studio, Mac and iOS app still shows everything."
      }
    },
    {
      "key": "wProgress",
      "type": "toggle",
      "group": "widget",
      "default": false,
      "label": {
        "de": "Fortschrittsbalken anzeigen",
        "en": "Show progress bar"
      }
    },
    {
      "key": "wAlbum",
      "type": "toggle",
      "group": "widget",
      "default": false,
      "label": {
        "de": "Album anzeigen",
        "en": "Show album"
      }
    },
    {
      "key": "wCompact",
      "type": "toggle",
      "group": "widget",
      "default": false,
      "label": {
        "de": "Kompakte Darstellung",
        "en": "Compact layout"
      }
    }
  ]
}
