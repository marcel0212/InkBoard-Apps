{
  "id": "rezepte",
  "name": {
    "de": "Rezepte",
    "en": "Recipes"
  },
  "version": "1.3.0",
  "apiLevel": 20,
  "pages": [
    {
      "de": "Rezepte",
      "en": "Recipes"
    }
  ],
  "refreshMinutes": 240,
  "input": true,
  "fetchAnywhere": true,
  "permissions": {
    "recipeAnyHost": true
  },
  "http": {
    "page": "assets/phone.html",
    "api": true
  },
  "settings": [
    {
      "key": "details",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Zusatzinfos zeigen (Quelle, Portionen, Zeit)",
        "en": "Show extra info (source, servings, time)"
      },
      "help": {
        "de": "Aus: unter dem Titel steht keine Zeile mit Quelle, Portionen und Zeit. Die Vorschau in Studio, Mac- und iOS-App zeigt weiterhin alles.",
        "en": "Off: no line with source, servings and time under the title. The preview in Studio, Mac and iOS app still shows everything."
      }
    },
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "classic"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "relief": "Relief (Tiefe)",
          "klar": "Klar (Apple)",
          "classic": "Klassisch"
        },
        "en": {
          "relief": "Relief (depth)",
          "klar": "Clear (Apple)",
          "classic": "Classic"
        }
      },
      "label": {
        "de": "Darstellung",
        "en": "Layout"
      }
    }
  ]
}
