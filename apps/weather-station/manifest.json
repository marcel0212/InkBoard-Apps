{
  "id": "weather-station",
  "name": {
    "de": "Wetter",
    "en": "Weather"
  },
  "version": "1.4.2",
  "apiLevel": 20,
  "standard": true,
  "pages": [
    {
      "de": "Innen",
      "en": "Indoor"
    },
    {
      "de": "Außen",
      "en": "Outdoor"
    },
    {
      "de": "Netzwerk",
      "en": "Network"
    }
  ],
  "refreshMinutes": 15,
  "sections": [
    {
      "id": "history",
      "title": {
        "de": "Verlauf",
        "en": "History"
      }
    }
  ],
  "settings": [
    {
      "key": "style",
      "type": "select",
      "options": [
        "cards",
        "flat",
        "compact"
      ],
      "default": "cards",
      "optionLabels": {
        "de": {
          "cards": "Bento",
          "flat": "Slate",
          "compact": "Nano"
        },
        "en": {
          "cards": "Bento",
          "flat": "Slate",
          "compact": "Nano"
        }
      },
      "label": {
        "de": "Stil der Seiten",
        "en": "Page style"
      }
    },
    {
      "key": "iconStyle",
      "type": "select",
      "options": [
        "device",
        "classic",
        "ink",
        "sketch",
        "watercolor",
        "crayon"
      ],
      "default": "device",
      "optionLabels": {
        "de": {
          "device": "Geräte-Einstellung",
          "classic": "Klassisch",
          "ink": "Tusche",
          "sketch": "Skizze",
          "watercolor": "Aquarell",
          "crayon": "Buntstift"
        },
        "en": {
          "device": "Device setting",
          "classic": "Classic",
          "ink": "Ink",
          "sketch": "Sketch",
          "watercolor": "Watercolor",
          "crayon": "Crayon"
        }
      },
      "label": {
        "de": "Wetter-Symbole der Seiten",
        "en": "Weather icons of the pages"
      },
      "previewPage": 1
    },
    {
      "key": "focus",
      "type": "select",
      "options": [
        "co2",
        "temperature",
        "humidity"
      ],
      "default": "co2",
      "optionLabels": {
        "de": {
          "co2": "CO2",
          "temperature": "Temperatur",
          "humidity": "Luftfeuchtigkeit"
        },
        "en": {
          "co2": "CO2",
          "temperature": "Temperature",
          "humidity": "Humidity"
        }
      },
      "label": {
        "de": "Fokuswert (großer Verlaufsgraph, nur Stil Bento)",
        "en": "Focus value (large trend chart, Bento style only)"
      },
      "section": "history"
    },
    {
      "key": "showTemp",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Temperatur zusätzlich anzeigen (kleiner Verlauf)",
        "en": "Also show temperature (small trend)"
      },
      "section": "history"
    },
    {
      "key": "showHum",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Luftfeuchtigkeit zusätzlich anzeigen (kleiner Verlauf)",
        "en": "Also show humidity (small trend)"
      },
      "section": "history"
    },
    {
      "key": "showCo2",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "CO2 zusätzlich anzeigen (kleiner Verlauf)",
        "en": "Also show CO2 (small trend)"
      },
      "section": "history"
    },
    {
      "key": "range",
      "type": "select",
      "options": [
        "24",
        "12",
        "6"
      ],
      "default": "24",
      "optionLabels": {
        "de": {
          "24": "24 Stunden",
          "12": "12 Stunden",
          "6": "6 Stunden"
        },
        "en": {
          "24": "24 hours",
          "12": "12 hours",
          "6": "6 hours"
        }
      },
      "label": {
        "de": "Zeitraum der Verlaufsgraphen (lokal gespeichert sind 24 Stunden)",
        "en": "Time range of the trend charts (24 hours are stored locally)"
      },
      "section": "history"
    },
    {
      "key": "storageProfile",
      "type": "select",
      "options": [
        "main",
        "app"
      ],
      "default": "main",
      "optionLabels": {
        "de": {
          "main": "Hauptspeicher",
          "app": "App-Speicher (getrennt)"
        },
        "en": {
          "main": "Main storage",
          "app": "App storage (separate)"
        }
      },
      "label": {
        "de": "Speicher",
        "en": "Storage"
      },
      "help": {
        "de": "App-Speicher: ein eigener, getrennter Speicher (FTP, WebDAV oder Google Drive) nur für Apps. Einrichten unter Einstellungen → App-Speicher.",
        "en": "App storage: a separate storage (FTP, WebDAV or Google Drive) just for apps. Set it up under Settings → App storage."
      },
      "section": "history"
    },
    {
      "key": "historyDir",
      "type": "storagePath",
      "device": "historyFtpPath",
      "default": "/inkboard",
      "label": {
        "de": "Verlauf: Ordner auf dem externen Speicher",
        "en": "History: folder on the external storage"
      },
      "help": {
        "de": "Hier legt die Wetter-App den Sensor-Verlauf ab (FTP, WebDAV oder Google Drive). Gilt geräteweit, wie in Einstellungen → Gerät → Wetter.",
        "en": "Where the weather app stores the sensor history (FTP, WebDAV or Google Drive). Applies device-wide, like Settings → Device → Weather."
      },
      "section": "history"
    },
    {
      "key": "wIconStyle",
      "type": "select",
      "options": [
        "device",
        "classic",
        "ink",
        "sketch",
        "watercolor",
        "crayon"
      ],
      "default": "device",
      "optionLabels": {
        "de": {
          "device": "Geräte-Einstellung",
          "classic": "Klassisch",
          "ink": "Tusche",
          "sketch": "Skizze",
          "watercolor": "Aquarell",
          "crayon": "Buntstift"
        },
        "en": {
          "device": "Device setting",
          "classic": "Classic",
          "ink": "Ink",
          "sketch": "Sketch",
          "watercolor": "Watercolor",
          "crayon": "Crayon"
        }
      },
      "group": "widget",
      "label": {
        "de": "Wetter-Symbole",
        "en": "Weather icons"
      },
      "previewPage": 1
    },
    {
      "key": "warn",
      "type": "toggle",
      "default": true,
      "group": "widget",
      "label": {
        "de": "Wetterwarnung zeigen (Unwetter, Frost, Regen in der nächsten Stunde)",
        "en": "Show weather warning (storm, frost, rain within the hour)"
      }
    }
  ],
  "nativeWidgets": [
    "weather_indoor",
    "weather_outdoor"
  ]
}
