{
  "id": "iphone-hinweise",
  "name": {"de": "Hinweise aufs iPhone", "en": "iPhone notices"},
  "version": "1.0.0",
  "apiLevel": 26,
  "pages": [
    {"de": "Überwachung", "en": "Monitoring"}
  ],
  "refreshMinutes": 10,
  "cycleFetch": true,
  "backgroundFetch": true,
  "widget": {"autoCompact": true, "w": 320, "h": 110},
  "permissions": {
    "net": ["ntfy.sh"],
    "netFrom": ["ownServer"],
    "mail": true
  },
  "sections": [
    {
      "id": "send",
      "title": {"de": "Versand", "en": "Sending"},
      "help": {
        "de": "Mitteilungen kommen über ntfy aufs iPhone: 1. Kostenlose App „ntfy“ aus dem App Store installieren. 2. Dort ein Thema abonnieren, am besten mit langem, zufälligem Namen (jeder, der den Namen kennt, könnte mitlesen). 3. Denselben Namen hier unter „Thema“ eintragen und „Test senden“ drücken. Alternativ per E-Mail (Empfänger aus den Geräteeinstellungen, höchstens 6 Mails am Tag). Auf dem Gerät bleibt nichts außer dem Thema gespeichert; es gibt keinen InkBoard-Server dazwischen.",
        "en": "Notices reach the iPhone through ntfy: 1. Install the free “ntfy” app from the App Store. 2. Subscribe to a topic there, ideally with a long random name (anyone who knows the name could read along). 3. Enter the same name here under “Topic” and press “Send test”. Alternatively by e-mail (recipient from the device settings, at most 6 mails a day). Nothing but the topic is stored on the device; there is no InkBoard server in between."
      },
      "helpTitle": {"de": "So richtest du es ein", "en": "How to set it up"}
    },
    {
      "id": "limits",
      "title": {"de": "Wann soll es melden?", "en": "When should it notify?"},
      "collapsed": true
    }
  ],
  "settings": [
    {
      "key": "style",
      "type": "select",
      "options": ["cards", "flat"],
      "default": "cards",
      "optionLabels": {
        "de": {"cards": "Bento", "flat": "Slate"},
        "en": {"cards": "Bento", "flat": "Slate"}
      },
      "label": {"de": "Stil", "en": "Style"}
    },
    {
      "key": "channel",
      "type": "select",
      "options": ["ntfy", "mail", "both"],
      "default": "ntfy",
      "optionLabels": {
        "de": {"ntfy": "ntfy (iPhone-Mitteilung)", "mail": "E-Mail", "both": "Beides"},
        "en": {"ntfy": "ntfy (iPhone notification)", "mail": "E-mail", "both": "Both"}
      },
      "label": {"de": "Versand über", "en": "Send via"},
      "section": "send"
    },
    {
      "key": "topic",
      "type": "text",
      "maxLen": 64,
      "default": "",
      "label": {"de": "Thema (Topic) in ntfy", "en": "Topic in ntfy"},
      "section": "send"
    },
    {
      "key": "server",
      "type": "select",
      "options": ["cloud", "own"],
      "default": "cloud",
      "optionLabels": {
        "de": {"cloud": "ntfy.sh", "own": "Eigener Server"},
        "en": {"cloud": "ntfy.sh", "own": "Own server"}
      },
      "label": {"de": "ntfy-Server", "en": "ntfy server"},
      "section": "send"
    },
    {
      "key": "ownServer",
      "type": "url",
      "label": {"de": "Adresse des eigenen Servers", "en": "Address of your own server"},
      "section": "send",
      "showIf": {"key": "server", "in": ["own"]}
    },
    {
      "key": "urgent",
      "type": "toggle",
      "default": true,
      "label": {"de": "Als dringend senden (Ton auch im Fokus-Modus nach Einstellung der ntfy-App)", "en": "Send as urgent (sound as set up in the ntfy app)"},
      "section": "send"
    },
    {
      "key": "test",
      "type": "select",
      "options": ["test"],
      "default": "test",
      "optionLabels": {"de": {"test": "–"}, "en": {"test": "–"}},
      "label": {"de": "Verbindung prüfen", "en": "Check the connection"},
      "action": {"name": "test", "label": {"de": "Test senden", "en": "Send test"}},
      "section": "send"
    },
    {
      "key": "watchCo2",
      "type": "toggle",
      "default": true,
      "label": {"de": "CO₂ zu hoch melden", "en": "Notify when CO₂ is too high"},
      "section": "limits"
    },
    {
      "key": "co2Ppm",
      "type": "number",
      "min": 600,
      "max": 3000,
      "default": 1200,
      "label": {"de": "CO₂-Grenze (ppm)", "en": "CO₂ limit (ppm)"},
      "section": "limits"
    },
    {
      "key": "watchHum",
      "type": "toggle",
      "default": true,
      "label": {"de": "Luftfeuchte zu niedrig oder zu hoch melden", "en": "Notify when humidity is too low or too high"},
      "section": "limits"
    },
    {
      "key": "humLow",
      "type": "number",
      "min": 10,
      "max": 50,
      "default": 30,
      "label": {"de": "Zu trocken unter (%)", "en": "Too dry below (%)"},
      "section": "limits"
    },
    {
      "key": "humHigh",
      "type": "number",
      "min": 50,
      "max": 95,
      "default": 70,
      "label": {"de": "Zu feucht über (%)", "en": "Too humid above (%)"},
      "section": "limits"
    },
    {
      "key": "watchBat",
      "type": "toggle",
      "default": true,
      "label": {"de": "Akku fast leer melden (dieses und andere Geräte)", "en": "Notify when a battery is almost empty (this and other devices)"},
      "section": "limits"
    },
    {
      "key": "batPct",
      "type": "number",
      "min": 5,
      "max": 50,
      "default": 20,
      "label": {"de": "Akku-Grenze (%)", "en": "Battery limit (%)"},
      "section": "limits"
    },
    {
      "key": "watchOff",
      "type": "toggle",
      "default": true,
      "label": {"de": "Melden, wenn ein Gerät im Netzwerk verschwindet", "en": "Notify when a device disappears from the network"},
      "section": "limits"
    },
    {
      "key": "offMin",
      "type": "number",
      "min": 15,
      "max": 720,
      "default": 45,
      "label": {"de": "Als offline melden nach (Minuten)", "en": "Report as offline after (minutes)"},
      "section": "limits"
    },
    {
      "key": "cooldown",
      "type": "number",
      "min": 10,
      "max": 1440,
      "default": 60,
      "label": {"de": "Dieselbe Meldung frühestens nach (Minuten)", "en": "Repeat the same notice after at least (minutes)"},
      "section": "limits"
    }
  ]
}
