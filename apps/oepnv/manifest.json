      "default": "transitous",
      "optionLabels": {
        "de": {
          "hvv": "HVV Geofox (Hamburg, Zugang nötig)",
          "transitous": "Transitous (bundesweit, ohne Anmeldung)",
          "db": "Deutsche Bahn (v6.db.transport.rest)"
        },
        "en": {
          "hvv": "HVV Geofox (Hamburg, access required)",
          "transitous": "Transitous (nationwide, no sign-up)",
          "db": "Deutsche Bahn (v6.db.transport.rest)"
        }
