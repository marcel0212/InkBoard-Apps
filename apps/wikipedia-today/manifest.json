{
  "id": "wikipedia-today",
  "name": {
    "de": "Was geschah heute",
    "en": "On this day"
  },
  "shortName": {
    "de": "Heute",
    "en": "Today"
  },
  "version": "1.1.1",
  "apiLevel": 8,
  "pages": [
    {
      "de": "Was geschah heute",
      "en": "On this day"
    }
  ],
  "refreshMinutes": 360,
  "retrySeconds": 30,
  "widget": {
    "autoCompact": true,
    "w": 340,
    "h": 150
  },
  "permissions": {
    "net": [
      "de.wikipedia.org",
      "en.wikipedia.org",
      "byabbe.se",
      "api.mymemory.translated.net",
      "translate.googleapis.com"
    ]
  },
  "settings": [
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "cards",
        "flat",
        "compact"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "cards": "Tile (Hero + Kacheln)",
          "flat": "Ledger (Zeitleiste)",
          "compact": "Nibble (Kompaktliste)",
          "relief": "Bump (Tiefe)",
          "klar": "Gamut (Apple)"
        },
        "en": {
          "cards": "Tile (hero + tiles)",
          "flat": "Ledger (timeline)",
          "compact": "Nibble (compact list)",
          "relief": "Bump (depth)",
          "klar": "Gamut (Apple)"
        }
      },
      "label": {
        "de": "Darstellung",
        "en": "Layout"
      }
    },
    {
      "key": "details",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Zusatzinfos zeigen („Auch an diesem Tag“)",
        "en": "Show extra info (\"Also on this day\")"
      },
      "help": {
        "de": "Aus: der Stil Karten zeigt nur das Haupt-Ereignis. Die Listen-Stile bleiben unverändert. Die Vorschau in Studio, Mac- und iOS-App zeigt weiterhin alles.",
        "en": "Off: the cards style only shows the main event. The list styles are unchanged. The preview in Studio, Mac and iOS app still shows everything."
      }
    }
  ]
}
