{
  "id": "todo-list",
  "name": {
    "de": "Aufgaben",
    "en": "Tasks"
  },
  "version": "1.1.9",
  "apiLevel": 6,
  "pages": [
    {
      "de": "Aufgaben",
      "en": "Tasks"
    }
  ],
  "refreshMinutes": 15,
  "widget": {
    "autoCompact": true,
    "w": 320,
    "h": 180
  },
  "permissions": {
    "net": [
      "caldav.icloud.com",
      "*.icloud.com",
      "api.todoist.com"
    ],
    "netFrom": [
      "a_url",
      "b_url",
      "c_url"
    ]
  },
  "sections": [
    {
      "id": "source1",
      "title": {
        "de": "Quelle 1",
        "en": "Source 1"
      },
      "help": {
        "de": "iCloud: Auf account.apple.com unter „Anmeldung und Sicherheit“ ein App-spezifisches Passwort erzeugen und hier eintragen (nicht das Apple-ID-Passwort). Benutzername ist die Apple-ID.\nNextcloud/CalDAV: App-Passwort aus den Sicherheitseinstellungen des Servers verwenden.\nTodoist: Token unter Todoist → Einstellungen → Integrationen → Entwickler kopieren.",
        "en": "iCloud: create an app-specific password at account.apple.com under Sign-In and Security and enter it here (not your Apple ID password). The user name is your Apple ID.\nNextcloud/CalDAV: use an app password from the server's security settings.\nTodoist: copy the token from Todoist → Settings → Integrations → Developer."
      },
      "helpTitle": {
        "de": "Zugangsdaten besorgen",
        "en": "Getting the credentials"
      },
      "helpUrl": "https://account.apple.com"
    },
    {
      "id": "source2",
      "title": {
        "de": "Quelle 2",
        "en": "Source 2"
      },
      "collapsed": true
    },
    {
      "id": "source3",
      "title": {
        "de": "Quelle 3",
        "en": "Source 3"
      },
      "collapsed": true
    },
    {
      "id": "display",
      "title": {
        "de": "Anzeige",
        "en": "Display"
      }
    }
  ],
  "settings": [
    {
      "key": "a_type",
      "type": "select",
      "options": [
        "off",
        "icloud",
        "nextcloud",
        "generic",
        "todoist"
      ],
      "default": "off",
      "optionLabels": {
        "de": {
          "off": "Aus",
          "icloud": "iCloud-Erinnerungen",
          "nextcloud": "Nextcloud",
          "generic": "Anderer CalDAV-Server",
          "todoist": "Todoist"
        },
        "en": {
          "off": "Off",
          "icloud": "iCloud Reminders",
          "nextcloud": "Nextcloud",
          "generic": "Other CalDAV server",
          "todoist": "Todoist"
        }
      },
      "label": {
        "de": "Quelle 1: Dienst",
        "en": "Source 1: service"
      },
      "section": "source1"
    },
    {
      "key": "a_url",
      "type": "url",
      "label": {
        "de": "Serveradresse",
        "en": "Server address"
      },
      "showIf": {
        "key": "a_type",
        "in": [
          "nextcloud",
          "generic"
        ]
      },
      "section": "source1"
    },
    {
      "key": "a_user",
      "type": "text",
      "maxLen": 100,
      "label": {
        "de": "Benutzername / Apple-ID",
        "en": "User name / Apple ID"
      },
      "showIf": {
        "key": "a_type",
        "in": [
          "icloud",
          "nextcloud",
          "generic"
        ]
      },
      "section": "source1"
    },
    {
      "key": "a_secret",
      "type": "password",
      "maxLen": 120,
      "label": {
        "de": "Passwort / Token",
        "en": "Password / token"
      },
      "showIf": {
        "key": "a_type",
        "in": [
          "icloud",
          "nextcloud",
          "generic",
          "todoist"
        ]
      },
      "action": {
        "name": "connect_a",
        "label": {
          "de": "Verbinden und Listen laden",
          "en": "Connect and load lists"
        },
        "fills": "a_list"
      },
      "section": "source1"
    },
    {
      "key": "a_list",
      "type": "text",
      "maxLen": 60,
      "label": {
        "de": "Liste / Projekt",
        "en": "List / project"
      },
      "showIf": {
        "key": "a_type",
        "in": [
          "icloud",
          "nextcloud",
          "generic",
          "todoist"
        ]
      },
      "section": "source1"
    },
    {
