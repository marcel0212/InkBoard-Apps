{
  "id": "sport-tabellen",
  "name": {
    "de": "Sport",
    "en": "Sports"
  },
  "version": "1.1.3",
  "apiLevel": 14,
  "pages": [
    {
      "de": "Team",
      "en": "Team"
    },
    {
      "de": "Liga-Tabelle",
      "en": "League table"
    }
  ],
  "refreshMinutes": 10,
  "retrySeconds": 60,
  "widget": {
    "w": 300,
    "h": 130
  },
  "permissions": {
    "net": [
      "sportal.de",
      "www.sportal.de",
      "en.wikipedia.org",
      "upload.wikimedia.org",
      "thumb.wikimedia.org"
    ]
  },
  "sections": [
    {
      "id": "general",
      "title": {
        "de": "Allgemein",
        "en": "General"
      },
      "help": {
        "de": "Die gewählte Sportart erscheint auf den Vollseiten. Alle Sportarten, für die unten ein Team eingetragen ist, werden im Hintergrund geladen und lassen sich über eigene Dashboard-Widgets anzeigen. Datenquelle sportal.de, ein Schlüssel ist nicht nötig.\nEchte Wappen: lädt in der Tile-Darstellung die Wappen des eigenen Teams und des nächsten Gegners von Wikipedia (sportal.de liefert keine). Findet sich kein passendes Bild, erscheint die farbige Kürzel-Kachel.",
        "en": "The chosen sport appears on the full pages. Every sport with a team entered below is loaded in the background and can be shown by its own dashboard widget. Data source sportal.de, no key needed.\nReal crests: in the Tile layout, loads the crests of your team and the next opponent from Wikipedia (sportal.de provides none). If no matching image is found, the coloured abbreviation tile is shown."
      }
    },
    {
      "id": "hockey",
      "title": {
        "de": "Eishockey (DEL)",
        "en": "Ice hockey (DEL)"
      },
      "help": {
        "de": "Leer lassen, wenn Eishockey nicht geladen werden soll. Mit „Teams laden“ erscheint die Liste der DEL-Teams zur Auswahl; der Name muss dem in der sportal-Tabelle entsprechen.",
        "en": "Leave empty to skip ice hockey. “Load teams” fills a list of the DEL teams; the name has to match the sportal table."
      }
    },
    {
      "id": "handball",
      "title": {
        "de": "Handball",
        "en": "Handball"
      },
      "help": {
        "de": "Leer lassen, wenn Handball nicht geladen werden soll. Zuerst die Liga wählen, dann „Teams laden“.",
        "en": "Leave empty to skip handball. Choose the league first, then “Load teams”."
      }
    },
    {
      "id": "basketball",
      "title": {
        "de": "Basketball",
        "en": "Basketball"
      },
      "help": {
        "de": "Leer lassen, wenn Basketball nicht geladen werden soll. Zuerst die Liga wählen, dann „Teams laden“.",
        "en": "Leave empty to skip basketball. Choose the league first, then “Load teams”."
      }
    },
    {
      "id": "football",
      "title": {
        "de": "American Football (NFL)",
        "en": "American football (NFL)"
      },
      "help": {
        "de": "Leer lassen, wenn American Football nicht geladen werden soll. Die Tabelle zeigt die Division des Teams.",
        "en": "Leave empty to skip American football. The table shows the team's division."
      }
    }
  ],
  "settings": [
    {
      "key": "kind",
      "type": "select",
      "options": [
        "eishockey",
        "handball",
        "basketball",
        "americanfootball"
      ],
      "default": "eishockey",
      "optionLabels": {
        "de": {
          "eishockey": "Eishockey (DEL)",
          "handball": "Handball",
          "basketball": "Basketball",
          "americanfootball": "American Football (NFL)"
        },
        "en": {
          "eishockey": "Ice hockey (DEL)",
          "handball": "Handball",
          "basketball": "Basketball",
          "americanfootball": "American football (NFL)"
        }
      },
      "label": {
        "de": "Angezeigte Sportart",
        "en": "Sport shown"
      },
      "section": "general"
    },
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "cards",
        "flat",
        "compact"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "cards": "Tile (Kacheln)",
          "flat": "Ledger (Spalten)",
          "compact": "Nibble (Zeitleiste)",
          "relief": "Bump (Tiefe)",
          "klar": "Gamut (Apple)"
        },
        "en": {
          "cards": "Tile (tiles)",
          "flat": "Ledger (columns)",
          "compact": "Nibble (timeline)",
          "relief": "Bump (depth)",
          "klar": "Gamut (Apple)"
        }
      },
      "label": {
        "de": "Darstellung",
        "en": "Layout"
      },
      "help": {
        "de": "Tile: großes nächstes Spiel mit Wappen und fünf Ergebniskacheln. Ledger: letzte und nächste Spiele in zwei Spalten. Nibble: Zeitleiste mit den Spielen. Die Tabelle gibt es in allen drei Darstellungen.",
        "en": "Tile: large next match with crests and five result tiles. Ledger: last and next matches in two columns. Nibble: timeline of the matches. The table is available in all three layouts."
      }
    },
    {
      "key": "teamEh",
      "type": "text",
      "maxLen": 40,
      "default": "",
      "label": {
        "de": "Team Eishockey (DEL)",
        "en": "Team ice hockey (DEL)"
      },
      "action": {
        "name": "teams_eh",
        "label": {
          "de": "Teams laden",
          "en": "Load teams"
        },
        "fills": "teamEh"
      },
      "section": "hockey"
    },
    {
      "key": "leagueHb",
      "type": "select",
      "options": [
        "bundesliga",
        "champions-league"
      ],
      "default": "bundesliga",
      "optionLabels": {
        "de": {
          "bundesliga": "Handball-Bundesliga",
          "champions-league": "EHF Champions League"
        },
        "en": {
          "bundesliga": "Handball Bundesliga",
          "champions-league": "EHF Champions League"
        }
      },
      "label": {
        "de": "Liga Handball",
        "en": "League handball"
      },
      "section": "handball"
    },
    {
      "key": "teamHb",
      "type": "text",
      "maxLen": 40,
      "default": "",
      "label": {
        "de": "Team Handball",
        "en": "Team handball"
      },
      "action": {
        "name": "teams_hb",
        "label": {
          "de": "Teams laden",
          "en": "Load teams"
        },
        "fills": "teamHb"
      },
      "section": "handball"
    },
    {
      "key": "leagueBb",
      "type": "select",
      "options": [
        "bundesliga",
        "euroleague"
      ],
      "default": "bundesliga",
      "optionLabels": {
        "de": {
          "bundesliga": "Basketball-Bundesliga (BBL)",
          "euroleague": "EuroLeague"
        },
        "en": {
          "bundesliga": "Basketball Bundesliga (BBL)",
          "euroleague": "EuroLeague"
        }
      },
      "label": {
        "de": "Liga Basketball",
        "en": "League basketball"
      },
      "section": "basketball"
    },
    {
      "key": "teamBb",
      "type": "text",
      "maxLen": 40,
      "default": "",
      "label": {
        "de": "Team Basketball",
        "en": "Team basketball"
      },
      "action": {
        "name": "teams_bb",
        "label": {
          "de": "Teams laden",
          "en": "Load teams"
        },
        "fills": "teamBb"
      },
      "section": "basketball"
    },
    {
      "key": "teamAf",
      "type": "text",
      "maxLen": 40,
      "default": "",
      "label": {
        "de": "Team American Football (NFL)",
        "en": "Team American football (NFL)"
      },
      "action": {
        "name": "teams_af",
        "label": {
          "de": "Teams laden",
          "en": "Load teams"
        },
        "fills": "teamAf"
      },
      "section": "football"
    },
    {
      "key": "crests",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Echte Wappen laden",
        "en": "Load real crests"
      },
      "section": "general"
    },
    {
      "key": "details",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Zusatzinfos zeigen (Heim/Auswärts, Spielort)",
        "en": "Show extra info (home/away, venue)"
      },
      "help": {
        "de": "Aus: im nächsten Spiel stehen kein „Heim/Auswärts“ und kein Spielort. Die Vorschau in Studio, Mac- und iOS-App zeigt weiterhin alles.",
        "en": "Off: the next match shows no home/away and no venue. The preview in Studio, Mac and iOS app still shows everything."
      }
    },
    {
      "key": "liveRefresh",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Live-Aktualisierung des Dashboards",
        "en": "Live dashboard refresh"
      },
      "help": {
        "de": "Läuft gerade ein Spiel und liegt das Widget auf dem Dashboard, wird das Dashboard in dem eingestellten Takt neu geladen und gezeichnet – auch wenn der normale Dashboard-Takt länger ist. Bei schwachem Akku (unter 15 %) und ohne Widget im Dashboard passiert das nicht. Jede Aktualisierung kostet Akku.",
        "en": "While a match is live and the widget is on the dashboard, the dashboard is reloaded and redrawn at the chosen interval – even if the normal dashboard interval is longer. Not done when the battery is low (below 15 %) or without the widget on the dashboard. Every refresh costs battery."
      }
    },
    {
      "key": "liveRefreshMin",
      "type": "select",
      "options": [
        "5",
        "10",
        "15",
        "20",
        "30"
      ],
      "default": "10",
      "optionLabels": {
        "de": {
          "5": "alle 5 Minuten",
          "10": "alle 10 Minuten",
          "15": "alle 15 Minuten",
          "20": "alle 20 Minuten",
          "30": "alle 30 Minuten"
        },
        "en": {
          "5": "every 5 minutes",
          "10": "every 10 minutes",
          "15": "every 15 minutes",
          "20": "every 20 minutes",
          "30": "every 30 minutes"
        }
      },
      "label": {
        "de": "Live-Takt",
        "en": "Live interval"
      },
      "help": {
        "de": "Abstand der Aktualisierungen während eines Spiels (Standard 10 Minuten). Nur wirksam, wenn die Live-Aktualisierung eingeschaltet ist.",
        "en": "Interval between refreshes during a match (default 10 minutes). Only applies when live refresh is on."
      }
    },
    {
      "key": "wHandball",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "Handball statt Eishockey",
        "en": "Handball instead of ice hockey"
      },
      "group": "widget"
    },
    {
      "key": "wBasketball",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "Basketball statt Eishockey",
        "en": "Basketball instead of ice hockey"
      },
      "group": "widget"
    },
    {
      "key": "wFootball",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "American Football statt Eishockey",
        "en": "American football instead of ice hockey"
      },
      "group": "widget"
    },
    {
      "key": "wTablePos",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "Tabellenplatz anzeigen",
        "en": "Show table position"
      },
      "group": "widget"
    },
    {
      "key": "wHomeAway",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "Heim/Auswärts anzeigen",
        "en": "Show home/away"
      },
      "group": "widget"
    }
  ],
  "fetchOnOpen": true
}
