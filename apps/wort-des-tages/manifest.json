{
  "id": "wort-des-tages",
  "name": {
    "de": "Wort des Tages",
    "en": "Word of the day"
  },
  "shortName": {
    "de": "WdT",
    "en": "WotD"
  },
  "version": "1.5.1",
  "apiLevel": 1,
  "pages": [
    {
      "de": "Wort des Tages",
      "en": "Word of the day"
    }
  ],
  "refreshMinutes": 360,
  "retrySeconds": 30,
  "widget": {
    "autoCompact": true,
    "w": 320,
    "h": 130
  },
  "permissions": {
    "net": [
      "www.merriam-webster.com",
      "api.mymemory.translated.net",
      "translate.googleapis.com"
    ]
  },
  "settings": [
    {
      "key": "showExample",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Beispielsatz anzeigen",
        "en": "Show example sentence"
      }
    },
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "classic"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "relief": "Bump (Tiefe)",
          "klar": "Gamut (Apple)",
          "classic": "Klassisch"
        },
        "en": {
          "relief": "Bump (depth)",
          "klar": "Gamut (Apple)",
          "classic": "Classic"
        }
      },
      "label": {
        "de": "Darstellung",
        "en": "Layout"
      }
    }
  ]
}
