{
  "id": "calendar-app",
  "name": {
    "de": "Kalender",
    "en": "Calendar"
  },
  "version": "1.1.2",
  "apiLevel": 20,
  "pages": [
    {
      "de": "Tag",
      "en": "Day",
      "ownDate": true
    },
    {
      "de": "Woche",
      "en": "Week",
      "ownDate": true
    },
    {
      "de": "Monat",
      "en": "Month",
      "ownDate": true
    }
  ],
  "refreshMinutes": 15,
  "widget": {
    "autoCompact": true,
    "w": 340,
    "h": 200,
    "relevantWhen": {
      "key": "lastEnd",
      "mode": "future"
    }
  },
  "permissions": {
    "net": [],
    "netFrom": [
      "src1Url",
      "src2Url",
      "src3Url",
      "src4Url"
    ]
  },
  "sections": [
    {
      "id": "src1",
      "title": {
        "de": "Quelle 1",
        "en": "Source 1"
      },
      "help": {
        "de": "Pro Quelle: ein Kalender-Link (ICS, iCal), eine Farbe und ein Schalter.\nGoogle Kalender: Einstellungen > Kalender integrieren > „Geheime Adresse im iCal-Format“.\nOutlook.com: Kalender > Freigeben > Veröffentlichen > ICS-Link.\niCloud: Kalender freigeben > „Öffentlicher Kalender“ (webcal:// wird automatisch zu https://).\nDer Link muss ohne Anmeldung abrufbar sein. Er ist geheim: nicht weitergeben.",
        "en": "Per source: a calendar link (ICS, iCal), a color and a switch.\nGoogle Calendar: Settings > Integrate calendar > “Secret address in iCal format”.\nOutlook.com: Calendar > Share > Publish > ICS link.\niCloud: Share calendar > “Public calendar” (webcal:// becomes https:// automatically).\nThe link must work without signing in. It is secret: do not share it."
      },
      "helpTitle": {
        "de": "Kalender-Link holen",
        "en": "Get the calendar link"
      }
    },
    {
      "id": "src2",
      "title": {
        "de": "Quelle 2",
        "en": "Source 2"
      }
    },
    {
      "id": "src3",
      "title": {
        "de": "Quelle 3",
        "en": "Source 3"
      }
    },
    {
      "id": "src4",
      "title": {
        "de": "Quelle 4",
        "en": "Source 4"
      }
    },
    {
      "id": "check",
      "title": {
        "de": "Quellen prüfen",
        "en": "Check sources"
      }
    },
    {
      "id": "day",
      "title": {
        "de": "Tagesansicht",
        "en": "Day view"
      }
    },
    {
      "id": "week",
      "title": {
        "de": "Wochen- und Monatsansicht",
        "en": "Week and month view"
      }
    },
    {
      "id": "layout",
      "title": {
        "de": "Darstellung",
        "en": "Layout"
      }
    }
  ],
  "settings": [
