      "label": {
        "de": "Städte (höchstens 6)",
        "en": "Cities (max. 6)"
      },
      "section": "cities",
      "help": {
        "de": "Eine Stadt pro Zeile, die erste ist die Bezugszeit. Wähle aus den 80 Vorschlägen oder trage einen Ort als „Name=Region/Stadt“ ein, zum Beispiel „Kathmandu=Asia/Kathmandu“ (bis zu drei, braucht Internet; Zonennamen auf worldtimeapi.org/timezones).",
        "en": "One city per line, the first is the reference. Pick from the 80 suggestions or enter a place as “name=Region/City”, for example “Kathmandu=Asia/Kathmandu” (up to three, needs internet; zone names at worldtimeapi.org/timezones)."
      }
    },
    {
      "key": "design",
      "type": "select",
      "options": [
        "karten",
        "heim",
        "analog",
        "tabelle",
        "sonne",
        "typo"
      ],
      "default": "karten",
      "optionLabels": {
        "de": {
          "karten": "Karten",
          "heim": "Heimzeit groß",
          "analog": "Analoguhren",
          "tabelle": "Tabelle",
          "sonne": "Sonne und Mond",
          "typo": "Typografisch"
        },
        "en": {
          "karten": "Cards",
          "heim": "Large home time",
          "analog": "Analog clocks",
          "tabelle": "Table",
          "sonne": "Sun and moon",
          "typo": "Typographic"
        }
      },
      "label": {
        "de": "Layout",
        "en": "Layout"
      },
      "section": "look",
      "help": {
        "de": "Karten: eine Karte je Stadt. Heimzeit groß: erste Stadt riesig, die anderen als Reihe. Analoguhren: Zifferblatt in jeder Karte. Tabelle: Zeilen mit Tag-/Nacht-Punkt. Sonne und Mond: Symbol je Stadt. Typografisch: große Zahl und schlichte Zeilen.",
        "en": "Cards: one card per city. Large home time: first city huge, the rest in a row. Analog clocks: a dial in each card. Table: rows with a day/night dot. Sun and moon: a symbol per city. Typographic: big number and plain rows."
      }
    },
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "cards",
        "flat",
        "compact"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "cards": "Tile (Kacheln)",
          "flat": "Ledger (Zeilen)",
          "compact": "Nibble (kompakt)",
          "relief": "Bump (Tiefe)",
          "klar": "Gamut (Apple)"
        },
        "en": {
          "cards": "Tile (tiles)",
          "flat": "Ledger (rows)",
          "compact": "Nibble (compact)",
          "relief": "Bump (depth)",
          "klar": "Gamut (Apple)"
        }
      },
      "label": {
        "de": "Darstellung",
        "en": "Layout"
      },
      "help": {
        "de": "Tile, Bump und Gamut zeigen jede Stadt als Karte mit großer Uhrzeit. Ledger und Nibble listen die Städte untereinander.",
        "en": "Tile, Bump and Gamut show every city as a card with a large time. Ledger and Nibble list the cities in rows."
      },
      "section": "look"
    }
