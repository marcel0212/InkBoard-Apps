          "krhs": "Kreis Heinsberg",
          "kronberg": "Kronberg im Taunus",
          "muelheim": "Mülheim an der Ruhr",
          "nds": "Norderstedt",
          "pi": "Kreis Pinneberg",
          "roe": "Roetgen",
          "solingen": "Solingen",
          "stl": "Lüdenscheid",
