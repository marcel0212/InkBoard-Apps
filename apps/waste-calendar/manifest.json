{
  "id": "waste-calendar",
  "name": {
    "de": "Müllabfuhr",
    "en": "Waste collection"
  },
  "shortName": {
    "de": "Müll",
    "en": "Waste"
  },
  "version": "1.2.0",
  "apiLevel": 9,
  "pages": [
    {
      "de": "Müllabfuhr",
      "en": "Waste collection"
    }
  ],
  "refreshMinutes": 360,
  "retrySeconds": 30,
  "widget": {
    "autoCompact": true,
    "w": 320,
    "h": 120
  },
  "permissions": {
    "netFrom": [
      "icsUrl"
    ]
  },
  "sections": [
    {
      "id": "source",
      "title": {
        "de": "Datenquelle",
        "en": "Data source"
      },
      "help": {
        "de": "1. Auf der Webseite deines Entsorgers den Abfuhrkalender für deine Adresse öffnen\n2. Kalender-Export oder Abo (ICS, iCal) wählen und den Link kopieren\n3. Beginnt der Link mit webcal://, ersetze das durch https://\nDer Link muss ohne Anmeldung abrufbar sein.",
        "en": "1. Open the collection calendar for your address on your waste company's website\n2. Choose the calendar export or subscription (ICS, iCal) and copy the link\n3. If the link starts with webcal://, replace that with https://\nThe link must work without signing in."
      },
      "helpTitle": {
        "de": "Kalender-Link holen",
        "en": "Get the calendar link"
      }
    }
  ],
  "settings": [
    {
      "key": "icsUrl",
      "type": "url",
      "label": {
        "de": "Kalender-Link (ICS)",
        "en": "Calendar link (ICS)"
      },
      "section": "source"
    },
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "cards",
        "flat",
        "compact"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "cards": "Tile (Tonnen-Kacheln)",
          "flat": "Ledger (Headline + Liste)",
          "compact": "Nibble (Monatskalender)",
          "relief": "Bump (Tiefe)",
          "klar": "Gamut (Apple)"
        },
        "en": {
          "cards": "Tile (bin tiles)",
          "flat": "Ledger (headline + list)",
          "compact": "Nibble (month calendar)",
          "relief": "Bump (depth)",
          "klar": "Gamut (Apple)"
        }
      },
      "label": {
        "de": "Darstellung",
        "en": "Layout"
      }
    },
    {
      "key": "wRest",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Restmüll",
        "en": "General waste"
      },
      "group": "widget"
    },
    {
      "key": "wBio",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Biotonne",
        "en": "Bio waste"
      },
      "group": "widget"
    },
    {
      "key": "wPaper",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Papiertonne",
        "en": "Paper"
      },
      "group": "widget"
    },
    {
      "key": "wYellow",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Gelbe Tonne",
        "en": "Recycling"
      },
      "group": "widget"
    },
    {
      "key": "wMore",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "Weitere Termine zeigen",
        "en": "Show more dates"
      },
      "group": "widget"
    }
  ]
}
