      "label": {
        "de": "Entsorger",
        "en": "Provider"
      },
      "showIf": {
        "key": "mode",
        "in": [
          "auto"
        ]
      },
      "section": "source"
    },
    {
      "key": "street",
      "type": "text",
      "maxLen": 40,
      "label": {
        "de": "Straße",
        "en": "Street"
      },
      "showIf": {
        "key": "mode",
        "in": [
          "auto"
        ]
      },
      "section": "source"
    },
    {
      "key": "houseNo",
      "type": "text",
      "maxLen": 8,
      "label": {
        "de": "Hausnummer",
        "en": "House number"
      },
      "showIf": {
        "key": "mode",
        "in": [
          "auto"
        ]
      },
      "section": "source"
    },
    {
      "key": "city",
      "type": "text",
      "maxLen": 40,
      "label": {
        "de": "Ort (nur bei mehreren Orten)",
        "en": "Place (only if the provider has several)"
      },
      "showIf": {
        "key": "mode",
        "in": [
          "auto"
        ]
      },
      "section": "source"
    },
    {
      "key": "style",
      "type": "select",
      "options": [
        "cards",
        "flat",
        "compact"
      ],
      "default": "flat",
      "optionLabels": {
        "de": {
          "cards": "Bento (Tonnen-Kacheln)",
          "flat": "Slate (Headline + Liste)",
          "compact": "Nano (Monatskalender)"
        },
        "en": {
          "cards": "Bento (bin tiles)",
          "flat": "Slate (headline + list)",
          "compact": "Nano (month calendar)"
        }
      },
      "label": {
        "de": "Darstellung",
        "en": "Layout"
      }
    },
    {
      "key": "wRest",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Restmüll",
        "en": "General waste"
      },
      "group": "widget"
    },
    {
      "key": "wBio",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Biotonne",
        "en": "Bio waste"
      },
      "group": "widget"
    },
    {
      "key": "wPaper",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Papiertonne",
        "en": "Paper"
      },
      "group": "widget"
    },
    {
      "key": "wYellow",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Gelbe Tonne",
        "en": "Recycling"
      },
      "group": "widget"
    },
    {
      "key": "wMore",
      "type": "toggle",
      "default": false,
      "label": {
        "de": "Weitere Termine zeigen",
        "en": "Show more dates"
      },
      "group": "widget"
    }
  ]
}