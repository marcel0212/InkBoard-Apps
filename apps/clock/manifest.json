{
  "id": "clock",
  "name": {
    "de": "Uhr",
    "en": "Clock"
  },
  "version": "1.1.2",
  "apiLevel": 2,
  "standard": true,
  "pages": 1,
  "refreshMinutes": 1,
  "widget": {
    "autoCompact": true,
    "w": 320,
    "h": 200
  },
  "settings": [
    {
      "key": "style",
      "type": "select",
      "options": [
        "relief",
        "klar",
        "bento",
        "slate",
        "nano"
      ],
      "default": "relief",
      "optionLabels": {
        "de": {
          "bento": "Tile",
          "slate": "Ledger",
          "nano": "Nibble",
          "relief": "Bump (Tiefe)",
          "klar": "Gamut (Apple)"
        },
        "en": {
          "bento": "Tile",
          "slate": "Ledger",
          "nano": "Nibble",
          "relief": "Bump (depth)",
          "klar": "Gamut (Apple)"
        }
      },
      "label": {
        "de": "Stil der App-Seite",
        "en": "App page style"
      }
    },
    {
      "key": "showDate",
      "type": "toggle",
      "default": true,
      "label": {
        "de": "Datum im Widget anzeigen",
        "en": "Show date in widget"
      }
    }
  ]
}
